# --- Telegram ---
# Get a token from @BotFather
TELEGRAM_BOT_TOKEN=

# --- RPC endpoints (one per supported chain) ---
# Leave these unset to use the built-in public endpoints (several per chain,
# tried in order). Public nodes often refuse datacenter IPs, so for anything
# beyond testing set your own Alchemy/Infura/QuickNode URL here - it is tried
# first, with the public ones kept behind it as a fallback.
# Check what actually answers with the bot's /diag command.
ETHEREUM_RPC_URL=https://eth.llamarpc.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
OPTIMISM_RPC_URL=https://mainnet.optimism.io
BASE_RPC_URL=https://mainnet.base.org
POLYGON_RPC_URL=https://polygon-rpc.com
BSC_RPC_URL=https://bsc-dataseed.binance.org
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
UNICHAIN_RPC_URL=https://mainnet.unichain.org
INK_RPC_URL=https://rpc-gel.inkonchain.com
LINEA_RPC_URL=https://rpc.linea.build
WORLDCHAIN_RPC_URL=https://worldchain-mainnet.g.alchemy.com/public
MODE_RPC_URL=https://mainnet.mode.network
BERACHAIN_RPC_URL=https://rpc.berachain.com
BLAST_RPC_URL=https://rpc.blast.io
CELO_RPC_URL=https://forno.celo.org

# --- CoinMarketCap (поиск токена по тикеру для /info) ---
# Без ключа команда /info по тикеру работать не будет; поиск по адресу
# контракта продолжит работать.
CMC_API_KEY=

# --- Storage ---
DB_PATH=./data/bot.db

# Реестр OFT LayerZero. Переопределять обычно не нужно.
LAYERZERO_OFT_LIST_URL=https://metadata.layerzero-api.com/v1/metadata/experiment/ofts/list

# Ручной конфиг адаптеров LayerZero: переопределяет реестр для указанных сетей.
LAYERZERO_CONFIG_PATH=./config/layerzero-lockboxes.json

# --- Real-time tracking (/track) ---
# How often (ms) the tracker polls chains with active subscriptions for new logs.
TRACK_POLL_INTERVAL_MS=60000
# Max blocks fetched per eth_getLogs call (keeps public RPCs happy).
TRACK_MAX_BLOCK_RANGE=2000
# On first-time tracking of a contract, how many blocks back to start polling from.
TRACK_INITIAL_LOOKBACK_BLOCKS=1000

# --- Optional third-party APIs (used to enrich /info with recent bridge activity) ---
LAYERZERO_SCAN_API=https://scan.layerzero-api.com/v1
WORMHOLESCAN_API=https://api.wormholescan.io
CIRCLE_IRIS_API=https://iris-api.circle.com/v2
