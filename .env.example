# --- Telegram ---
# Get a token from @BotFather
TELEGRAM_BOT_TOKEN=

# --- RPC endpoints (one per supported chain) ---
# Leave these unset to use the built-in public endpoints (several per chain,
# tried in order). Public nodes often refuse datacenter IPs, so for anything
# beyond testing set your own Alchemy/Infura/QuickNode URL here - it is tried
# first, with the public ones kept behind it as a fallback.
# Check what actually answers with the bot's /diag command.
ETHEREUM_RPC_URL=https://eth.llamarpc.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
OPTIMISM_RPC_URL=https://mainnet.optimism.io
BASE_RPC_URL=https://mainnet.base.org
POLYGON_RPC_URL=https://polygon-rpc.com
BSC_RPC_URL=https://bsc-dataseed.binance.org
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
UNICHAIN_RPC_URL=https://mainnet.unichain.org
INK_RPC_URL=https://rpc-gel.inkonchain.com
LINEA_RPC_URL=https://rpc.linea.build
WORLDCHAIN_RPC_URL=https://worldchain-mainnet.g.alchemy.com/public
MODE_RPC_URL=https://mainnet.mode.network
BERACHAIN_RPC_URL=https://rpc.berachain.com
BLAST_RPC_URL=https://rpc.blast.io
CELO_RPC_URL=https://forno.celo.org

# Сети, добавленные позже. Публичные эндпоинты уже прописаны в коде -
