# --- Не-EVM сети ---
# У каждой свой эндпоинт, и у всех он необязательный: без переменной берутся
# публичные. Публичные тут особенно склонны отключаться, отставать от сети
# или требовать ключ, поэтому для рабочего бота свой надёжнее. Заданный
# эндпоинт пробуется первым, публичные остаются запасными.
# SOLANA_RPC_URL=          # helius.dev, quicknode, alchemy
# ECLIPSEMAINNET_RPC_URL=
# STARKNET_RPC_URL=        # alchemy отдаёт Starknet
# RADIX_RPC_URL=           # публичные шлюзы Radix регулярно отстают от реестра
# ALEO_RPC_URL=
# CELESTIA_REST_URL=
# NEUTRON_REST_URL=
# OSMOSIS_REST_URL=

# --- CoinGecko (поиск токена по тикеру для /info) ---
# Ключ НЕ обязателен: CoinGecko отвечает и без него. Но бесплатный лимит
# считается на IP, а хостинг делит адрес с чужими ботами — поэтому без ключа
# в ответ регулярно прилетает 429. Бесплатный ключ снимает это:
# coingecko.com → API → Demo.
COINGECKO_API_KEY=
# Меняется только вместе с тарифом: api.coingecko.com для Demo и без ключа,
# pro-api.coingecko.com для Pro. От этого зависит и заголовок с ключом.
COINGECKO_API_BASE=https://api.coingecko.com

# --- Storage ---
DB_PATH=./data/bot.db

# Реестр OFT LayerZero. Переопределять обычно не нужно.
LAYERZERO_OFT_LIST_URL=https://metadata.layerzero-api.com/v1/metadata/experiment/ofts/list

# Метаданные сетей LayerZero: оттуда берутся eid сетей, у которых EndpointV2
# лежит не по стандартному адресу (zk-сети). Переопределять обычно не нужно.
LAYERZERO_METADATA_URL=https://metadata.layerzero-api.com/v1/metadata

# Ручной конфиг адаптеров LayerZero: переопределяет реестр для указанных сетей.
LAYERZERO_CONFIG_PATH=./config/layerzero-lockboxes.json

# --- Real-time tracking (/track) ---
# How often (ms) the tracker polls chains with active subscriptions for new logs.
TRACK_POLL_INTERVAL_MS=60000
# Max blocks fetched per eth_getLogs call (keeps public RPCs happy).
TRACK_MAX_BLOCK_RANGE=2000
# On first-time tracking of a contract, how many blocks back to start polling from.
TRACK_INITIAL_LOOKBACK_BLOCKS=1000

# --- Optional third-party APIs (used to enrich /info with recent bridge activity) ---
LAYERZERO_SCAN_API=https://scan.layerzero-api.com/v1
WORMHOLESCAN_API=https://api.wormholescan.io
CIRCLE_IRIS_API=https://iris-api.circle.com/v2

# --- Тонкая настройка (менять обычно не нужно) ---
# Сколько потоков libuv отдаёт под блокирующие задачи. Через них идёт
# резолвинг доменов (dns.lookup), а его нужно сотни за один проход по сетям:
# при штатных четырёх потоках запросы ждут не ноду, а очередь, и живая сеть
# выпадает из отчёта как «нет ответа». Бот сам ставит 32, если переменная не
# задана; здесь она нужна только чтобы задать другое значение.
UV_THREADPOOL_SIZE=32
