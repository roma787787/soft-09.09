# --- Telegram ---
# Get a token from @BotFather
TELEGRAM_BOT_TOKEN=

# --- RPC endpoints (one per supported chain) ---
# Defaults below are public, rate-limited endpoints good enough for testing.
# For production, replace with your own Alchemy/Infura/QuickNode/Ankr URLs.
ETHEREUM_RPC_URL=https://eth.llamarpc.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
OPTIMISM_RPC_URL=https://mainnet.optimism.io
BASE_RPC_URL=https://mainnet.base.org
POLYGON_RPC_URL=https://polygon-rpc.com
BSC_RPC_URL=https://bsc-dataseed.binance.org
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/C

# --- Storage ---
DB_PATH=./data/bot.db

# --- Real-time tracking (/track) ---
# How often (ms) the tracker polls chains with active subscriptions for new logs.
TRACK_POLL_INTERVAL_MS=60000
# Max blocks fetched per eth_getLogs call (keeps public RPCs happy).
TRACK_MAX_BLOCK_RANGE=2000
# On first-time tracking of a contract, how many blocks back to start polling from.
TRACK_INITIAL_LOOKBACK_BLOCKS=1000

# --- Optional third-party APIs (used to enrich /info with recent bridge activity) ---
LAYERZERO_SCAN_API=https://scan.layerzero-api.com/v1
WORMHOLESCAN_API=https://api.wormholescan.io
CIRCLE_IRIS_API=https://iris-api.circle.com/v2
