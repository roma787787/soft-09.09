# --- CoinMarketCap (поиск токена по тикеру для /info) ---
# Без ключа команда /info по тикеру работать не будет; поиск по адресу
# контракта продолжит работать.
CMC_API_KEY=

# --- Storage ---
DB_PATH=./data/bot.db

# Реестр OFT LayerZero. Переопределять обычно не нужно.
LAYERZERO_OFT_LIST_URL=https://metadata.layerzero-api.com/v1/metadata/experiment/ofts/list

# Метаданные сетей LayerZero: оттуда берутся eid сетей, у которых EndpointV2
# лежит не по стандартному адресу (zk-сети). Переопределять обычно не нужно.
LAYERZERO_METADATA_URL=https://metadata.layerzero-api.com/v1/metadata

# Ручной конфиг адаптеров LayerZero: переопределяет реестр для указанных сетей.
LAYERZERO_CONFIG_PATH=./config/layerzero-lockboxes.json

# --- Real-time tracking (/track) ---
# How often (ms) the tracker polls chains with active subscriptions for new logs.
TRACK_POLL_INTERVAL_MS=60000
# Max blocks fetched per eth_getLogs call (keeps public RPCs happy).
TRACK_MAX_BLOCK_RANGE=2000
# On first-time tracking of a contract, how many blocks back to start polling from.
TRACK_INITIAL_LOOKBACK_BLOCKS=1000

# --- Optional third-party APIs (used to enrich /info with recent bridge activity) ---
LAYERZERO_SCAN_API=https://scan.layerzero-api.com/v1
WORMHOLESCAN_API=https://api.wormholescan.io
CIRCLE_IRIS_API=https://iris-api.circle.com/v2
