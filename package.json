{
  "name": "bridge-liquidity-tracker",
  "version": "1.0.0",
  "description": "Telegram bot that reports how much of a token each bridge custody contract holds (Wormhole/Portal, Hyperlane warp routes, LayerZero OFT adapters), plus contract identification by address.",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "check:addresses": "tsx scripts/check-addresses.ts",
    "selftest": "tsx scripts/selftest.ts"
  },
  "dependencies": {
    "@across-protocol/constants": "^3.1.125",
    "@hyperlane-xyz/registry": "^26.1.0",
    "@wormhole-foundation/sdk-base": "^6.1.5",
    "better-sqlite3": "^11.9.1",
    "dotenv": "^16.4.5",
    "telegraf": "^4.16.3",
    "viem": "^2.21.55"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20 <23"
  }
}
